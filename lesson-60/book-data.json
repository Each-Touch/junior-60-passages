    {
      "cover": false,
      "sentenceId": 1,
      "sourceSentenceId": 1,
      "chunkId": "s60-p01",
      "image": "assets/images/01.webp",
      "audio": "assets/audio/segments/s60-p01.mp3",
      "en": "AI can help teenagers and students learn in several ways.",
      "cn": "人工智能可以在多个方面帮助青少年和学生们学习。"
    },
    {
      "cover": false,
      "sentenceId": 2,
      "sourceSentenceId": 2,
      "chunkId": "s60-p02",
      "image": "assets/images/02.webp",
      "audio": "assets/audio/segments/s60-p02.mp3",
      "en": "Personalised learning: AI can know better about students, including their advantages, weaknesses, skills, learning favourites, and learning needs, and so on.",
      "cn": "个性化学习：人工智能能够更好地了解学生，包括他们的优点、缺点、技能、学习偏好、学习需求等。"
    },
    {
      "cover": false,
      "sentenceId": 3,
      "sourceSentenceId": 3,
      "chunkId": "s60-p03",
      "image": "assets/images/03.webp",
      "audio": "assets/audio/segments/s60-p03.mp3",
      "en": "Then it can create a proper learning plan for each student.",
      "cn": "然后，它可以为每个学生制订合适的学习计划。"
    },
    {
      "cover": false,
      "sentenceId": 4,
      "sourceSentenceId": 4,
      "chunkId": "s60-p04",
      "image": "assets/images/04.webp",
      "audio": "assets/audio/segments/s60-p04.mp3",
      "en": "This can help students concentrate on areas that they need to improve at their own speed.",
      "cn": "这有助于学生按照自己的节奏专注于需要提高的领域。"
    },
    {
      "cover": false,
      "sentenceId": 5,
      "sourceSentenceId": 5,
      "chunkId": "s60-p05",
      "image": "assets/images/05.webp",
      "audio": "assets/audio/segments/s60-p05.mp3",
      "en": "Interactive learning: Forget about the learning method of yesterday!",
      "cn": "交互式学习：忘掉过去的学习方法吧！"
    },
    {
      "cover": false,
      "sentenceId": 6,
      "sourceSentenceId": 6,
      "chunkId": "s60-p06",
      "image": "assets/images/06.webp",
      "audio": "assets/audio/segments/s60-p06.mp3",
      "en": "AI has the ability to make learning more interactive and interesting.",
      "cn": "人工智能有能力让学习变得更具互动性和趣味性。"
    },
    {
      "cover": false,
      "sentenceId": 7,
      "sourceSentenceId": 7,
      "chunkId": "s60-p07",
      "image": "assets/images/07.webp",
      "audio": "assets/audio/segments/s60-p07.mp3",
      "en": "Interactive learning apps and educational games can make students learn more carefully.",
      "cn": "交互式学习应用程序和寓教于乐的游戏可以让学生学得更认真。"
    },
    {
      "cover": false,
      "sentenceId": 8,
      "sourceSentenceId": 8,
      "chunkId": "s60-p08",
      "image": "assets/images/08.webp",
      "audio": "assets/audio/segments/s60-p08.mp3",
      "en": "The new method is sure to be more helpful than studying alone.",
      "cn": "这种新方法一定会比单独学习更有帮助。"
    },
    {
      "cover": false,
      "sentenceId": 9,
      "sourceSentenceId": 9,
      "chunkId": "s60-p09",
      "image": "assets/images/09.webp",
      "audio": "assets/audio/segments/s60-p09.mp3",
      "en": "Automated advice and help: AI can examine students' work and provide personalised help.",
      "cn": "自动建议和帮助：人工智能可以检查学生的作业，并提供个性化帮助。"
    },
    {
      "cover": false,
      "sentenceId": 10,
      "sourceSentenceId": 10,
      "chunkId": "s60-p10",
      "image": "assets/images/10.webp",
      "audio": "assets/audio/segments/s60-p10.mp3",
      "en": "For example, ChatGPT can answer students' questions quickly in a private, low-pressure way.",
      "cn": "例如，ChatGPT可以以一种私密的、没什么压力的方式快速回答学生的问题。"
    },
    {
      "cover": false,
      "sentenceId": 11,
      "sourceSentenceId": 11,
      "chunkId": "s60-p11",
      "image": "assets/images/11.webp",
      "audio": "assets/audio/segments/s60-p11.mp3",
      "en": "This kind of advice and answers can help students better understand knowledge and use their knowledge.",
      "cn": "这样的建议和解答可以帮助学生更好地理解并运用知识。"
    },
    {
      "cover": false,
      "sentenceId": 12,
      "sourceSentenceId": 12,
      "chunkId": "s60-p12",
      "image": "assets/images/12.webp",
      "audio": "assets/audio/segments/s60-p12.mp3",
      "en": "Greater resources: AI can make learning resources richer and wider, like electronic textbooks, online courses, and study apps.",
      "cn": "更丰富的资源：人工智能可以使学习资源更加丰富和广泛，如电子教科书、在线课程和学习应用程序。"
    },
    {
      "cover": false,
      "sentenceId": 13,
      "sourceSentenceId": 13,
      "chunkId": "s60-p13",
      "image": "assets/images/13.webp",
      "audio": "assets/audio/segments/s60-p13.mp3",
      "en": "For example, a biology textbook with AI technology may provide interactive 3D models of a human body.",
      "cn": "例如，采用人工智能技术的生物教科书可以提供人体的交互式3D模型。"
    },
    {
      "cover": false,
      "sentenceId": 14,
      "sourceSentenceId": 14,
      "chunkId": "s60-p14-01",
      "image": "assets/images/14.webp",
      "audio": "assets/audio/segments/s60-p14-01.mp3",
      "en": "Students may also be able to talk to a simulated empress in history to know more about her life, for example,",
      "cn": "学生还能够与虚拟的历史女皇对话，了解她的生平，比如她选择的结婚对象以及选择他的原因。"
    },
    {
      "cover": false,
      "sentenceId": 15,
      "sourceSentenceId": 14,
      "chunkId": "s60-p14-02",
      "image": "assets/images/14.webp",
      "audio": "assets/audio/segments/s60-p14-02.mp3",
      "en": "whom she chose to marry and why.",
      "cn": "学生还能够与虚拟的历史女皇对话，了解她的生平，比如她选择的结婚对象以及选择他的原因。"
    },
    {
      "cover": false,
      "sentenceId": 16,
      "sourceSentenceId": 15,
      "chunkId": "s60-p15",
      "image": "assets/images/15.webp",
      "audio": "assets/audio/segments/s60-p15.mp3",
      "en": "AI can provide interactive examples, introduce important passages, and offer assessments.",
      "cn": "人工智能可以提供交互式案例，介绍重要文章，并提供测评。"
    },
    {
      "cover": false,
      "sentenceId": 17,
      "sourceSentenceId": 16,
      "chunkId": "s60-p16",
      "image": "assets/images/16.webp",
      "audio": "assets/audio/segments/s60-p16.mp3",
      "en": "In a word, AI has a great ability to improve studying and learning.",
      "cn": "总之，人工智能在提升学习效果方面有强大的能力。"
    },
    {
      "cover": false,
      "sentenceId": 18,
      "sourceSentenceId": 17,
      "chunkId": "s60-p17",
      "image": "assets/images/17.webp",
      "audio": "assets/audio/segments/s60-p17.mp3",
      "en": "By using AI, students can study smarter and reach higher levels of learning and success.",
      "cn": "通过使用人工智能，学生可以更高效地学习，达到更高的学习水平并取得更大的成功。"
    },
    {
      "cover": false,
      "sentenceId": 19,
      "sourceSentenceId": 18,
      "chunkId": "s60-p18",
      "image": "assets/images/18.webp",
      "audio": "assets/audio/segments/s60-p18.mp3",
      "en": "The future of AI in education is hopeful as technologies continue to develop.",
      "cn": "随着科技的不断发展，人工智能在教育领域的未来充满希望。"
