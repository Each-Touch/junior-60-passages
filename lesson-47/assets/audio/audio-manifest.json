  "sentences": [
    {
      "id": 1,
      "text": "Squirrels are cute and interesting animals that can be found in many parts of the world.",
      "file": "assets/audio/sentences/sentence-01.mp3",
      "exists": true
    },
    {
      "id": 2,
      "text": "They are known for their long tails, big teeth and the ability to climb trees.",
      "file": "assets/audio/sentences/sentence-02.mp3",
      "exists": true
    },
    {
      "id": 3,
      "text": "They can jump up to about 3 metres in height, and they can run up to about 30 kilometres every hour.",
      "file": "assets/audio/sentences/sentence-03.mp3",
      "exists": true
    },
    {
      "id": 4,
      "text": "Squirrels have soft bodies.",
      "file": "assets/audio/sentences/sentence-04.mp3",
      "exists": true
    },
    {
      "id": 5,
      "text": "Their eyes are high on their small heads and are placed on each side, so they can see wide and far without having to turn around.",
      "file": "assets/audio/sentences/sentence-05.mp3",
      "exists": true
    },
    {
      "id": 6,
      "text": "This often helps them get out of danger from their enemies like foxes and wolves.",
      "file": "assets/audio/sentences/sentence-06.mp3",
      "exists": true
    },
    {
      "id": 7,
      "text": "Squirrels have four big teeth in the front of their mouth that keep growing all through their lives.",
      "file": "assets/audio/sentences/sentence-07.mp3",
      "exists": true
    },
    {
      "id": 8,
      "text": "They are known for their love of nuts, and they can eat as much food as their body weight each week.",
      "file": "assets/audio/sentences/sentence-08.mp3",
      "exists": true
    },
    {
      "id": 9,
      "text": "They often keep nuts in the ground for the long winter months.",
      "file": "assets/audio/sentences/sentence-09.mp3",
      "exists": true
    },
    {
      "id": 10,
      "text": "Many people think that squirrels only eat nuts, but this isn't true.",
      "file": "assets/audio/sentences/sentence-10.mp3",
      "exists": true
    },
    {
      "id": 11,
      "text": "Their diet also includes plants, fruits, eggs, small animals and even young snakes.",
      "file": "assets/audio/sentences/sentence-11.mp3",
      "exists": true
    },
    {
      "id": 12,
      "text": "One funny thing is that squirrels are good at planting trees.",
      "file": "assets/audio/sentences/sentence-12.mp3",
      "exists": true
    },
    {
      "id": 13,
      "text": "They hide the fruits of oak trees in the soil, but often forget where they put them.",
      "file": "assets/audio/sentences/sentence-13.mp3",
      "exists": true
    },
    {
      "id": 14,
      "text": "In the end, the forgotten fruits become big trees.",
      "file": "assets/audio/sentences/sentence-14.mp3",
      "exists": true
    },
    {
      "id": 15,
      "text": "Sometimes we even find them in our yards.",
      "file": "assets/audio/sentences/sentence-15.mp3",
      "exists": true
    }
  ],
