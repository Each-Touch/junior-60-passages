  "word_method": "independent word generation, not extracted from sentence audio",
  "sentences": [
    {
      "id": 1,
      "text": "In China, there are 24 solar terms in a year.",
      "file": "assets/audio/sentences/sentence-01.mp3",
      "exists": true
    },
    {
      "id": 2,
      "text": "Six of them are in winter.",
      "file": "assets/audio/sentences/sentence-02.mp3",
      "exists": true
    },
    {
      "id": 3,
      "text": "They are Beginning of Winter, Light Snow, Heavy Snow, Winter Solstice, Lesser Cold and Greater Cold.",
      "file": "assets/audio/sentences/sentence-03.mp3",
      "exists": true
    },
    {
      "id": 4,
      "text": "Beginning of Winter usually falls on November 7th or 8th, when people wear warm trousers to stay cozy.",
      "file": "assets/audio/sentences/sentence-04.mp3",
      "exists": true
    },
    {
      "id": 5,
      "text": "On this day, after a year of hard work, people are happy to have a rest and spend time with their families, including their brothers, sisters and cousins.",
      "file": "assets/audio/sentences/sentence-05.mp3",
      "exists": true
    },
    {
      "id": 6,
      "text": "In ancient times, the northern part of China celebrated Beginning of Winter as the 'Small Spring Festival'.",
      "file": "assets/audio/sentences/sentence-06.mp3",
      "exists": true
    },
    {
      "id": 7,
      "text": "People usually had delicious dumplings and mutton soup on that day.",
      "file": "assets/audio/sentences/sentence-07.mp3",
      "exists": true
    },
    {
      "id": 8,
      "text": "Light Snow usually falls on November 22nd or 23rd and Heavy Snow usually falls on December 7th or 8th.",
      "file": "assets/audio/sentences/sentence-08.mp3",
      "exists": true
    },
    {
      "id": 9,
      "text": "When Winter Solstice comes, it brings the shortest day of the year and the longest night.",
      "file": "assets/audio/sentences/sentence-09.mp3",
      "exists": true
    },
    {
      "id": 10,
      "text": "Many places around the country can expect the coldest weather.",
      "file": "assets/audio/sentences/sentence-10.mp3",
      "exists": true
    },
    {
      "id": 11,
      "text": "People usually cancel outdoor activities.",
      "file": "assets/audio/sentences/sentence-11.mp3",
      "exists": true
    },
    {
      "id": 12,
      "text": "When they go outside, they have to wear warm coats and scarves.",
      "file": "assets/audio/sentences/sentence-12.mp3",
      "exists": true
    },
    {
      "id": 13,
      "text": "Trees lose their leaves and the land looks dead.",
      "file": "assets/audio/sentences/sentence-13.mp3",
      "exists": true
    },
    {
      "id": 14,
      "text": "Farmers take care of their sheep and pigs, making sure they are safe in the cold.",
      "file": "assets/audio/sentences/sentence-14.mp3",
      "exists": true
    },
    {
      "id": 15,
      "text": "Greater Cold comes after Lesser Cold.",
      "file": "assets/audio/sentences/sentence-15.mp3",
      "exists": true
    },
    {
      "id": 16,
      "text": "The field is covered with snow.",
      "file": "assets/audio/sentences/sentence-16.mp3",
      "exists": true
    },
    {
      "id": 17,
      "text": "And all Chinese are ready to welcome the Spring Festival after it.",
      "file": "assets/audio/sentences/sentence-17.mp3",
      "exists": true
    },
    {
      "id": 18,
      "text": "People take the lanterns and fireworks out, and children use scissors to make paper cuttings.",
      "file": "assets/audio/sentences/sentence-18.mp3",
      "exists": true
    },
    {
      "id": 19,
      "text": "Of course, a new round of solar terms will start.",
      "file": "assets/audio/sentences/sentence-19.mp3",
      "exists": true
    }
  ],
